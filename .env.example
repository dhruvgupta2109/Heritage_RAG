# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Phase 2 providers
# Models remain visible but disabled until the corresponding key authenticates.
OPENAI_API_KEY=
GEMINI_API_KEY=

# bcrypt hash for the default local upload password: Password
UPLOAD_PASSWORD_HASH=$2b$12$hZAfbzIRTRpil8xgYFEVheOqFk/ba0R7RZ4zlb7iiIdOm6mid1tv6

# Local paths
# Defaults are the repository's DOCS/ and data/ folders.
# DOCS_DIR=/absolute/path/to/documents
# DATA_DIR=/absolute/path/to/runtime-data

# Browser-to-API connection
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
